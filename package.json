{
  "name": "orbie-studio",
  "productName": "Orbie Studio",
  "version": "1.0.0",
  "description": "Your team's AI game studio. Claude Code agents build Roblox games side by side.",
  "author": "Cohesive",
  "license": "UNLICENSED",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "vendor": "node build/vendor.js",
    "dist": "node build/vendor.js && electron-builder --win --x64",
    "release": "node build/release.js"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "marked": "18.1.1",
    "dompurify": "3.4.17"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "resedit": "3.1.0"
  },
  "build": {
    "appId": "com.cohesive.orbiestudio",
    "productName": "Orbie Studio",
    "copyright": "© 2026 Cohesive",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/selftest.js",
      "package.json",
      "!node_modules/@lydell/node-pty-linux-x64/**",
      "!**/*.map",
      "!**/*.pdb"
    ],
    "extraFiles": [
      {
        "from": "src/guide/Orbie Studio Quick Guide.pdf",
        "to": "Orbie Studio Quick Guide.pdf"
      }
    ],
    "asar": false,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "afterPack": "build/afterPack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "executableName": "Orbie Studio"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Orbie Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "Orbie-Studio-Setup-${version}.exe",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "electronLanguages": [
      "en-US"
    ],
    "portable": {
      "artifactName": "Orbie-Studio-${version}-portable.exe",
      "requestExecutionLevel": "user",
      "unpackDirName": "OrbieStudio"
    },
    "publish": null
  },
  "agentDeck": {
    "electron": "44.7.2"
  }
}